    "type": "fa-module",
    "license": "GPL-3.0",
    "version": "1.0.0",
    "authors": [{"name": "Kevin Fraser", "email": "kevin@ksfraser.com"}],
    "require": {"php": ">=7.3", "ksfraser/related-to-core": "^1.1", "ksfraser/ksf-fa-common": "^1.0"},
    "require-dev": {"phpunit/phpunit": "^9.6"},
    "autoload": {"psr-4": {"Ksfraser\\FrontAccounting\\HRM\\Leave\\": "src/Ksfraser/FrontAccounting/HRM/Leave/"}},
    "minimum-stability": "dev", "prefer-stable": true,
    "config": {"process-timeout": 0, "platform": {"php": "7.4.33"}},
    "repositories": [{"type": "path", "url": "../ksf_related_to_core", "symlink": true}]
